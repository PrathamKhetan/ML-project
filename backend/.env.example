# Server Port
PORT=5001

# Allowed Frontend URL for CORS (set to your Vercel deployment URL)
CLIENT_URL=https://ml-project-frontend-two.vercel.app

# MongoDB Atlas Connection String
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/auditai?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/auditai?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=auditai_enterprise_jwt_secret_key_change_in_production!

# Email SMTP Notification Settings (Nodemailer)
# For Gmail: Use smtp.gmail.com with an App Password (not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
ALERT_FROM=alerts@auditai.com
ALERT_TO_FALLBACK=compliance-team@auditai.com

# Anthropic Claude API for "Ask AuditAI" Assistant
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022
